{
  "rewrites": [
    {
      "source": "/uploads/themes/samples/:file",
      "destination": "/:file"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?r=sitemap"
    },
    {
      "source": "/study-material",
      "destination": "/api/seo?r=hub"
    },
    {
      "source": "/ppt/:a",
      "destination": "/api/seo?r=ppt&a=:a"
    },
    {
      "source": "/topic/:a",
      "destination": "/api/seo?r=topic&a=:a"
    },
    {
      "source": "/topic/:a/:b",
      "destination": "/api/seo?r=topic&a=:a&b=:b"
    },
    {
      "source": "/open/file",
      "destination": "/api/seo?r=file"
    },
    {
      "source": "/open/:a/:b",
      "destination": "/api/seo?r=open&a=:a&b=:b"
    },
    {
      "source": "/board/:a",
      "destination": "/api/seo?r=board&a=:a"
    },
    {
      "source": "/board/:a/:b",
      "destination": "/api/seo?r=board&a=:a&b=:b"
    }
  ],
  "headers": [
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/account.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/thank-you.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/track.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/hit.js": {
      "includeFiles": "config.js"
    },
    "api/seo.js": {
      "includeFiles": "{config.js,js/catnav.js}"
    },
    "api/ai-ppt.js": {
      "maxDuration": 120
    }
  }
}
